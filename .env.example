# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY: Your Supabase anonymous API key
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Extension config (if omitted, extension script falls back to VITE_* values)
EXTENSION_SUPABASE_URL="https://your-project.supabase.co"
EXTENSION_SUPABASE_ANON_KEY="your-anon-key"
# APP redirect URL used by frontend OAuth flow (set this to your deployed app URL)
VITE_APP_URL="https://your-app-domain.com"
# Browser extension store/public page URL (Chrome Web Store or landing page)
VITE_EXTENSION_STORE_URL="https://chromewebstore.google.com/detail/your-extension-id"
